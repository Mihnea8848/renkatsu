<!-- Build with: dotnet build -c Release -p:GameDir=/path/to/Koikatsu -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>Renkatsu.ReferenceCapture</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DebugType>none</DebugType>
    <Managed>$(GameDir)/CharaStudio_Data/Managed</Managed>
    <FrameworkPathOverride>$(Managed)</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(Managed)/mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(Managed)/System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(Managed)/System.Core.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
  </ItemGroup>
</Project>
